node_modules/
.DS_Store
*.log

# Wrangler's local miniflare state. It caches request and response bodies on disk,
# so it is never committed.
.wrangler/

# Local credentials. Nothing here is ever committed.
#
# secrets/ holds the Google service-account JSON. It is ignored wholesale — only the
# README explaining what belongs there is tracked. If you ever see a *.json under
# secrets/ appear in `git status`, stop and fix this file before committing anything.
secrets/*
!secrets/README.md

.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
