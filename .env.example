# Local development only. Copy to `.env` — which is gitignored — and fill in.
# In production these are Cloudflare Pages → Settings → Variables and secrets.
#
# The service-account JSON must NOT be copied into this repository. Either point
# GOOGLE_APPLICATION_CREDENTIALS at wherever you downloaded it, or paste the key below.

# 1 = always show the demo calendar and never contact Google, whatever else is set here.
# 0 = read the live sheet; if that fails for any reason, the demo calendar is shown anyway.
DEMO=0

# Configuration only, never a security boundary. Nothing in the browser reads it.
CLOUDFLARE_ON=0

# The service account the sheet is shared with, as Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Either paste the key (literal \n sequences are handled, so a one-line paste works) ...
GOOGLE_PRIVATE_KEY=

# ... or, local only, point at the downloaded JSON. See secrets/README.md — that whole
# directory is gitignored. Whichever of the two is set wins.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json

# From the sheet's URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SPREADSHEET_ID=

# Optional. The default reads from row 1 so the header row is included — see README.
GOOGLE_SHEET_RANGE=EventCalendar!A1:V9999
